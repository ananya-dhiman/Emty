{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "emty",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../backend run build && npm run setup:sidecar && npm run dev",
    "beforeBuildCommand": "npm --prefix ../backend run build && npm run setup:sidecar && npm run setup:ollama-sidecar && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "widget",
        "title": "Emty Widget",
        "width": 340,
        "height": 240,
        "resizable": false,
        "alwaysOnTop": false,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "cyan_on_white32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../backend/.env",
      "../../backend/package.json",
      "../../backend/dist/**/*",
      "../../backend/node_modules/**/*"
    ],
    "externalBin": [
      "binaries/node",
      "binaries/ollama"
    ]
  }
}