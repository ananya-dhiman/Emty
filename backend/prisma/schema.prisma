// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ================================
// User Model (Auth-level user)
// ================================
model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  email          String    @unique
  name           String?
  avatar         String?
  firebaseId     String    @unique
  aiSettings     Json?     // Stores { geminiApiKey?, openaiApiKey?, preferredProvider?, preferredModel? }
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("User")
}

// ================================
// Gmail Account Model (Multiple accounts per user)
// ================================
model GmailAccount {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  userId            String
  emailAddress      String    @unique
  accessToken       String
  refreshToken      String
  tokenExpiry       DateTime
  syncCheckpointId  String?   @db.ObjectId
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("GmailAccount")
}

// ================================
// Label Model (Organization)
// ================================
model Label {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  userId            String
  accountId         String
  name              String
  nameNormalized    String
  description       String?
  color             String?
  source            String    @default("system") // "system" | "ai" | "user"
  status            String    @default("active") // "active" | "suggested" | "rejected"
  suggestionCount   Int       @default(0)
  lastSuggestedAt   DateTime?
  sampleThreadIds   String[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, accountId, nameNormalized])
  @@index([userId])
  @@index([accountId])
  @@index([status])
  @@map("Label")
}

// ================================
// EmailMessage Model (Staging for emails)
// ================================
model EmailMessage {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  userId            String
  accountId         String
  messageId         String
  threadId          String
  from              String
  subject           String
  snippet           String
  internalDate      DateTime
  hasAttachments    Boolean   @default(false)
  extractedFeatures String[]
  score             Float?
  aiProcessed       Boolean   @default(false) @index
  priorityState     String    @default("pending") // "top" | "low" | "pending"
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([accountId, messageId])
  @@index([accountId])
  @@index([userId])
  @@index([score])
  @@index([priorityState])
  @@map("EmailMessage")
}

// ================================
// SyncCheckpoint Model (Sync state tracking)
// ================================
model SyncCheckpoint {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  accountId             String    @unique
  lastHistoryId         String?
  lastSyncTimestamp     DateTime?
  syncState             String    @default("idle") // "idle" | "syncing" | "error"
  syncStartedAt         DateTime?
  lastSyncError         String?
  processedCount        Int       @default(0)
  succeededCount        Int       @default(0)
  failedCount           Int       @default(0)
  progressPercent       Int       @default(0)
  progressStage         String    @default("initializing")
  progressMessage       String?
  totalCandidates       Int       @default(0)
  processedCandidates   Int       @default(0)
  lastProgressAt        DateTime?
  aiFallbackCount       Int       @default(0)
  aiFallbackMessage     String?
  aiFallbackAt          DateTime?
  quotaDateUtc          String?
  dailyQuotaLimit       Int       @default(0)
  dailyQuotaUsed        Int       @default(0)
  dailyQuotaRemaining   Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("SyncCheckpoint")
}

// ================================
// ProcessedEmailLog Model (Deduplication)
// ================================
model ProcessedEmailLog {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  accountId         String
  messageId         String
  insightId         String    @db.ObjectId
  threadId          String
  previousStateHash String
  previousLabels    String[]
  internalDate      DateTime
  processedAt       DateTime  @default(now())
  retryCount        Int       @default(0)
  lastRetryAt       DateTime?
  lastErrorMessage  String?
  errorType         String    @default("none") // "transient" | "permanent" | "unknown" | "none"
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([accountId, messageId])
  @@index([accountId])
  @@index([accountId, retryCount, errorType])
  @@map("ProcessedEmailLog")
}

// ================================
// Insight Model (Context-level understanding)
// ================================
model Insight {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  userId            String
  accountId         String
  docType           String?   @default("thread_insight")
  gmailThreadId     String
  emailIds          String[]
  threadId          String?   @db.ObjectId
  from              Json      // { email, name?, domain? }
  labels            Json[]    // Array of { labelId?, name, source, statusSnapshot, matchScore? }
  labelSuggestions  Json[]    // Array of { labelId?, name, source, status, confidence?, generatedAt }
  importanceScore   Float?
  baseScore         Float?
  baseScoreBreakdown Json?    // { importanceNorm?, labelNorm?, matchedLabelRank? }
  baseScoreComputedAt DateTime?
  summary           Json      // { shortSnippet, intent }
  dates             Json[]    // Array of { type, date, sourceEmailId }
  attachments       Json[]    // Array of attachment metadata
  checklist         Json[]    // Array of checklist items
  state             Json?     // Flexible state object
  emails            Json[]    // Array of detailed email objects
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([accountId])
  @@index([gmailThreadId])
  @@map("Insight")
}

// ================================
// LabelPriorityConfig Model
// ================================
model LabelPriorityConfig {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  userId            String
  accountId         String
  priorities        Json[]    // Array of { labelId, labelNameSnapshot, rank }
  isReviewedByUser  Boolean   @default(false)
  initializedAt     DateTime?
  lastComputedAt    DateTime?
  lastEditedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, accountId])
  @@index([userId])
  @@map("LabelPriorityConfig")
}

// ================================
// UserIntentProfile Model
// ================================
model UserIntentProfile {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  userId              String    @unique
  includeKeywords     String[]
  preferredDomains    String[]
  excludeKeywords     String[]
  blockedDomains      String[]
  boostedEmailIds     String[]
  suppressedEmailIds  String[]
  intentSummary       String    @default("")
  userPrompt          String[]
  inferredLabels      String[]
  weights             Json      @default("{ \"keyword\": 10, \"domain\": 20, \"feedback\": 50 }")
  onboardingCompleted Boolean   @default(false)
  lastUpdated         DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("UserIntentProfile")
}

// ================================
// AIUsageDaily Model
// ================================
model AIUsageDaily {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @index
  dateKey         String    @index // UTC date key: YYYY-MM-DD
  processedCount  Int       @default(0)
  quotaLimit      Int
  lastUpdatedAt   DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, dateKey])
  @@map("AIUsageDaily")
}

// ================================
// RankingFeedbackLog Model
// ================================
model RankingFeedbackLog {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @index
  insightId       String?   @db.ObjectId @index
  messageId       String?   @index
  signal          String    // "boost" | "suppress" | "none"
  predictedScore  Float
  source          String    // "ai_insight" | "pre_filter"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, insightId])
  @@index([userId, messageId])
  @@map("RankingFeedbackLog")
}

// ================================
// Rule Model (Intent)
// ================================
model Rule {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  accountId       String    @db.ObjectId
  type            String    // "LABEL" | "DELETE"
  conditions      Json
  action          Json
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("Rule")
}
